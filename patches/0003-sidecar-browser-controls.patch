+      browser(), base::BindLambdaForTesting([&] { refreshed = true; }));
+  ASSERT_TRUE(base::test::RunUntil([&] { return refreshed; }));
+  EXPECT_EQ(second, restored.entries()[0].id);
+  ASSERT_NE(nullptr, restored.FindTab(first));
+  auto handle = restored.FindTab(first)->GetHandle();
+  EXPECT_TRUE(restored.Remove(first));
+  EXPECT_FALSE(sidecar::IsFavoriteTab(handle.Get()));
+  EXPECT_TRUE(model->IsTabPinned(model->GetIndexOfTab(handle.Get())));
