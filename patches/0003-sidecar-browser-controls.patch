+using CommandBarMap =
+    std::map<BrowserWindowInterface*, base::WeakPtr<views::Widget>>;
+CommandBarMap& CommandBars() {
+  static base::NoDestructor<CommandBarMap> bars;
+  return *bars;
+}
+
+class CommandBar : public views::View,
+                   public views::TextfieldController,
+                   public views::WidgetObserver {
+  METADATA_HEADER(CommandBar, views::View)
+ public:
+  explicit CommandBar(BrowserWindowInterface* browser)
+      : browser_(browser->GetWeakPtr()) {
+    AddAccelerator(ui::Accelerator(ui::VKEY_W, ui::EF_PLATFORM_ACCELERATOR));
+    SetBackground(
+        views::CreateRoundedRectBackground(ui::kColorPrimaryBackground, 16));
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(18), 12));
+    input_ = AddChildView(std::make_unique<views::Textfield>());
+    input_->SetController(this);
+    input_->SetPlaceholderText(u"Search or enter a URL…");
+    input_->SetAccessibleName(u"Search or enter a URL");
+    input_->SetFontList(input_->GetFontList().DeriveWithSizeDelta(6));
+    input_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(12, 8)));
+    input_->SetBackgroundColor(ui::kColorPrimaryBackground);
+
+    results_ = AddChildView(std::make_unique<views::View>());
+    results_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+    layout->SetFlexForView(results_, 1);
+    auto* hint = AddChildView(std::make_unique<views::Label>(
+        u"↑ ↓ Choose    Return Open    ⌘ Return New tab    Esc Cancel"));
+    hint->SetEnabledColor(ui::kColorSecondaryForeground);
+    hint->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    Refresh();
+  }
+
+  views::Textfield* input() const { return input_; }
+
+  void AddedToWidget() override {
+    views::View::AddedToWidget();
+    GetWidget()->AddObserver(this);
+  }
+
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget->RemoveObserver(this);
+  }
+
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active) {
+      widget->Close();
+    }
+  }
+
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override {
+    GetWidget()->Close();
+    return true;
+  }
+
+  bool HandleKeyEvent(views::Textfield*, const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if (event.key_code() == ui::VKEY_ESCAPE) {
+      GetWidget()->Close();
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_RETURN) {
+      Open(event.IsCommandDown() ? targets_.size() - 1 : selected_);
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_DOWN || event.key_code() == ui::VKEY_UP) {
+      const int count = static_cast<int>(buttons_.size());
+      if (count) {
+        selected_ =
+            (selected_ + (event.key_code() == ui::VKEY_DOWN ? 1 : -1) + count) %
+            count;
+        UpdateSelection();
+      }
+      return true;
+    }
+    return false;
+  }
+
+  void ContentsChanged(views::Textfield*, const std::u16string&) override {
+    Refresh();
+  }
+
+ private:
+  void Refresh() {
+    buttons_.clear();
+    targets_.clear();
+    results_->RemoveAllChildViews();
+    selected_ = 0;
+    if (!browser_) {
+      return;
+    }
+    const auto query = base::ToLowerASCII(input_->GetText());
+    auto* model = browser_->GetTabStripModel();
+    for (int i = 0; i < model->count() && targets_.size() < 6; ++i) {
+      auto* contents = model->GetWebContentsAt(i);
+      if (i == model->active_index() && query.empty()) {
+        continue;
+      }
+      const auto searchable = base::ToLowerASCII(
+          contents->GetTitle() + u" " +
+          base::UTF8ToUTF16(contents->GetVisibleURL().spec()));
+      if (!query.empty() && searchable.find(query) == std::u16string::npos) {
+        continue;
+      }
+      AddResult((model->IsTabPinned(i) ? u"Pinned  ·  " : u"Tab  ·  ") +
+                    (contents->GetTitle().empty()
+                         ? base::UTF8ToUTF16(contents->GetVisibleURL().spec())
+                         : contents->GetTitle()),
+                contents->GetWeakPtr());
+    }
+    AddResult(query.empty() ? u"New blank tab"
+                            : std::u16string(u"Open / search  ·  ") +
+                                  std::u16string(input_->GetText()),
+              nullptr);
+    UpdateSelection();
+    SetPreferredSize(gfx::Size(580, 116 + 42 * buttons_.size()));
+    if (GetWidget()) {
+      GetWidget()->SetSize(
+          gfx::Size(GetWidget()->GetWindowBoundsInScreen().width(),
+                    GetPreferredSize().height()));
+    }
+    InvalidateLayout();
+  }
+
+  void AddResult(const std::u16string& title,
+                 base::WeakPtr<content::WebContents> contents) {
+    const size_t index = targets_.size();
+    targets_.push_back(contents);
+    auto* button = results_->AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(&CommandBar::Open, base::Unretained(this), index),
+        title));
+    button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 10)));
+    button->SetPreferredSize(gfx::Size(0, 38));
+    button->SetTooltipText(title);
+    buttons_.push_back(button);
+  }
+
+  void UpdateSelection() {
+    for (size_t i = 0; i < buttons_.size(); ++i) {
+      buttons_[i]->SetBackground(views::CreateRoundedRectBackground(
+          static_cast<int>(i) == selected_ ? ui::kColorItemSelectionBackground
+                                           : ui::kColorPrimaryBackground,
+          8));
+    }
+  }
+
+  void Open(size_t index) {
+    if (!browser_ || index >= targets_.size()) {
+      return;
+    }
+    auto* model = browser_->GetTabStripModel();
+    if (auto contents = targets_[index]) {
+      const int tab_index = model->GetIndexOfWebContents(contents.get());
+      if (tab_index >= 0) {
+        model->ActivateTabAt(tab_index);
+      }
+    } else if (index + 1 == targets_.size()) {
+      std::u16string text;
+      base::TrimWhitespace(input_->GetText(), base::TRIM_ALL, &text);
+      if (text.empty()) {
+        chrome::NewTab(browser_.get(), NewTabTypes::kNewTabCommand);
+      } else {
+        AutocompleteMatch match;
+        AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile())
+            ->Classify(text, false, false, metrics::OmniboxEventProto::BLANK,
+                       &match, nullptr);
+        if (!match.destination_url.is_valid() ||
+            match.destination_url.SchemeIs("javascript")) {
+          return;
+        }
+        NavigateParams params(browser_.get(), match.destination_url,
+                              ui::PAGE_TRANSITION_TYPED);
+        params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+        Navigate(&params);
+      }
+    } else {
+      Refresh();
+      return;
+    }
+    GetWidget()->Close();
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Textfield> input_ = nullptr;
+  raw_ptr<views::View> results_ = nullptr;
+  std::vector<raw_ptr<views::LabelButton>> buttons_;
+  std::vector<base::WeakPtr<content::WebContents>> targets_;
+  int selected_ = 0;
+};
+BEGIN_METADATA(CommandBar)
+END_METADATA
+}  // namespace
+
+void ShowCommandBar(BrowserWindowInterface* browser) {
+  auto* bars = &CommandBars();
+  std::erase_if(*bars, [](const auto& entry) { return !entry.second; });
+  auto it = bars->find(browser);
+  if (it != bars->end()) {
+    it->second->Activate();
+    return;
+  }
+  auto delegate = std::make_unique<views::DialogDelegate>();
+  delegate->SetButtons(0);
+  delegate->SetShowTitle(false);
+  delegate->SetShowCloseButton(false);
+  delegate->SetTitle(u"Search or enter a URL");
+  delegate->set_margins(gfx::Insets(0));
+  auto* bar = delegate->SetContentsView(std::make_unique<CommandBar>(browser));
+  delegate->SetInitiallyFocusedView(bar->input());
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(delegate), browser->GetWindow()->GetNativeWindow(),
+      BrowserView::GetBrowserViewForBrowser(browser)
+          ->GetWidget()
+          ->GetNativeView());
+  (*bars)[browser] = widget->GetWeakPtr();
+  auto bounds = browser->GetWindow()->GetBounds();
+  const int width = std::min(580, std::max(280, bounds.width() - 40));
+  widget->SetBounds(gfx::Rect(bounds.CenterPoint().x() - width / 2,
+                              bounds.y() + std::min(130, bounds.height() / 5),
+                              width, bar->GetPreferredSize().height()));
+  widget->Show();
+}
+
+bool CloseCommandBar(BrowserWindowInterface* browser) {
+  auto& bars = CommandBars();
+  auto it = bars.find(browser);
+  if (it == bars.end() || !it->second || it->second->IsClosed()) {
+    return false;
+  }
+  it->second->Close();
+  bars.erase(it);
+  return true;
+}
+
+bool ClosePinnedTab(BrowserWindowInterface* browser) {
+  auto* model = browser->GetTabStripModel();
+  const int index = model->active_index();
+  if (index < 0 || !model->IsTabPinned(index)) {
+    return false;
+  }
+  auto contents = model->GetWebContentsAt(index)->GetWeakPtr();
+  const bool can_unload = !contents->NeedToFireBeforeUnloadOrUnloadEvents();
+  // Preserve pages with unload handlers (e.g. unsaved forms) instead of
+  // silently discarding them. The pin stays available regardless of unloading
+  // support.
+  if (model->count() == 1) {
+    chrome::NewTab(browser, NewTabTypes::kNoUserAction);
+  } else {
+    model->ActivateTabAt(index + 1 < model->count() ? index + 1 : index - 1);
+  }
+  if (contents && can_unload) {
+    if (auto* lifecycle =
+            resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+                contents.get())) {
+      lifecycle->DiscardTab(mojom::LifecycleUnitDiscardReason::EXTERNAL);
+    }
+  }
+  return true;
+}
+}  // namespace sidecar
