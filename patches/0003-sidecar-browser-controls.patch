+                              const TabStripModelChange&,
+                              const TabStripSelectionChange&) override;
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override;
+
+ private:
+  void ScheduleRefresh();
+  void Refresh();
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  base::RepeatingClosure changed_;
+  PrefChangeRegistrar prefs_observer_;
+  std::map<std::string, tabs::TabHandle> tabs_;
+  std::map<std::string, GURL> last_seen_;
+  bool refresh_pending_ = false;
+  base::WeakPtrFactory<FavoritesController> weak_factory_{this};
+};
+bool IsFavoriteTab(const tabs::TabInterface* tab);
