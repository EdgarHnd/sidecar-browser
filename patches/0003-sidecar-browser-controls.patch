+
+TEST_F(SidecarPinnedTabTest,
+       FavoritesSharedWithinProfileAndSeparatedAcrossProfiles) {
+  sidecar::FavoritesController first(browser(), base::RepeatingClosure());
+  AddTab(browser(), GURL("https://example.test/home"));
+  ASSERT_TRUE(first.AddActive());
+  const auto id = first.entries()[0].id;
+  auto second_browser =
+      CreateBrowser(profile(), BrowserWindowInterface::TYPE_NORMAL, false);
+  auto other_profile = std::make_unique<TestingProfile>();
+  auto other_browser = CreateBrowser(
+      other_profile.get(), BrowserWindowInterface::TYPE_NORMAL, false);
+  {
+    sidecar::FavoritesController second(second_browser.get(),
+                                        base::RepeatingClosure());
+    sidecar::FavoritesController other(other_browser.get(),
+                                       base::RepeatingClosure());
+    EXPECT_EQ(id, second.entries()[0].id);
+    EXPECT_TRUE(other.entries().empty());
+    EXPECT_EQ(nullptr, second.FindTab(id));
+    EXPECT_TRUE(second.Remove(id));
+    EXPECT_TRUE(first.entries().empty());
+  }
+  second_browser->GetTabStripModel()->CloseAllTabs();
+  other_browser->GetTabStripModel()->CloseAllTabs();
+}
+
+TEST_F(SidecarPinnedTabTest, InvalidSavedFavoritesAreIgnored) {
+  base::ListValue values;
+  values.Append("malformed");
+  base::DictValue unsafe;
+  unsafe.Set("id", "invalid");
+  unsafe.Set("url", "javascript:alert(1)");
+  values.Append(std::move(unsafe));
+  profile()->GetPrefs()->SetList(brave_tabs::kSidecarFavorites,
+                                 std::move(values));
+  sidecar::FavoritesController favorites(browser(), base::RepeatingClosure());
+  EXPECT_TRUE(favorites.entries().empty());
+}
+
+TEST_F(SidecarPinnedTabTest, FavoriteDropReordersAndRejectsForeignData) {
+  auto view = sidecar::CreateFavoritesView(browser(), base::RepeatingClosure());
+  auto* favorites = sidecar::FavoritesController::ForBrowser(browser());
+  ASSERT_TRUE(favorites);
+  AddTab(browser(), GURL("https://example.test/first"));
+  ASSERT_TRUE(favorites->AddActive());
+  AddTab(browser(), GURL("https://example.test/second"));
+  ASSERT_TRUE(favorites->AddActive());
+  const auto second = favorites->entries()[1].id;
+  base::RunLoop().RunUntilIdle();
+  view->SetBounds(0, 0, 260, 100);
+  view->DeprecatedLayoutImmediately();
+
+  const auto format =
+      ui::ClipboardFormatType::CustomPlatformType("org.sidecar.favorite");
+  base::Pickle pickle;
+  pickle.WriteString(second);
+  ui::OSExchangeData data;
+  data.SetPickledData(format, pickle);
+  EXPECT_TRUE(view->CanDrop(data));
+  const ui::DropTargetEvent event(data, gfx::PointF(20, 40),
+                                  gfx::PointF(20, 40),
+                                  ui::DragDropTypes::DRAG_MOVE);
+  EXPECT_EQ(ui::DragDropTypes::DRAG_MOVE, view->OnDragUpdated(event));
+  auto callback = view->GetDropCallback(event);
+  auto operation = ui::mojom::DragOperation::kNone;
+  std::move(callback).Run(event, operation, nullptr);
+  EXPECT_EQ(ui::mojom::DragOperation::kMove, operation);
+  EXPECT_EQ(second, favorites->entries()[0].id);
+
+  ui::OSExchangeData unrelated;
+  EXPECT_FALSE(view->CanDrop(unrelated));
+  base::Pickle unknown;
+  unknown.WriteString("not-a-saved-favorite");
+  unrelated.SetPickledData(format, unknown);
+  EXPECT_FALSE(view->CanDrop(unrelated));
+  data.MarkRendererTaintedFromOrigin(
+      url::Origin::Create(GURL("https://example.test")));
+  EXPECT_FALSE(view->CanDrop(data));
+}
