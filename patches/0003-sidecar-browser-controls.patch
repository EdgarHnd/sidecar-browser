+    address_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 12)));
+    address_->SetBackground(views::CreateRoundedRectBackground(
+        ui::kColorSubtleEmphasisBackground, 10));
+    browser->GetTabStripModel()->AddObserver(this);
+    Update();
+  }
+
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                             const TabStripSelectionChange&) override {
+    Update();
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override { Update(); }
+
+ private:
+  views::LabelButton* AddCommand(views::View* parent,
+                                const std::u16string& text,
+                                const std::u16string& tooltip, int command) {
+    auto* button = parent->AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating([](base::WeakPtr<BrowserWindowInterface> browser,
+                              int id) {
+          if (browser) {
+            chrome::ExecuteCommand(browser.get(), id);
+          }
+        }, browser_, command), text));
+    button->SetTooltipText(tooltip);
+    button->SetAccessibleName(tooltip);
+    button->SetMinSize(gfx::Size(32, 32));
+    return button;
+  }
+  void Update() {
+    if (!browser_) {
+      return;
+    }
+    auto* contents = browser_->GetTabStripModel()->GetActiveWebContents();
+    back_->SetEnabled(contents && contents->GetController().CanGoBack());
+    forward_->SetEnabled(contents && contents->GetController().CanGoForward());
+    const GURL url = contents ? contents->GetVisibleURL() : GURL();
+    address_->SetText(url.has_host()
+                          ? base::UTF8ToUTF16(url.DeprecatedGetOriginAsURL().spec())
+                          : u"Search or enter URL");
+    address_->SetTooltipText(base::UTF8ToUTF16(url.spec()));
+  }
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<views::LabelButton> address_ = nullptr;
+  raw_ptr<views::LabelButton> back_ = nullptr;
+  raw_ptr<views::LabelButton> forward_ = nullptr;
+};
