+
+TEST_F(SidecarPinnedTabTest, FavoritesReorderPersistAndReturnToPinnedTabs) {
+  auto* model = browser()->GetTabStripModel();
+  std::string first, second;
+  {
+    sidecar::FavoritesController favorites(browser(), base::RepeatingClosure());
+    AddTab(browser(), GURL("https://example.test/first"));
