+  }
+  bool GetDropFormats(int* formats,
+                      std::set<ui::ClipboardFormatType>* types) override {
+    *formats = ui::OSExchangeData::PICKLED_DATA;
+    types->insert(FavoriteFormat());
+    return true;
+  }
+  bool AreDropTypesRequired() override { return true; }
+  bool CanDrop(const ui::OSExchangeData& data) override {
+    return !ReadDrag(data).empty();
+  }
+  int OnDragUpdated(const ui::DropTargetEvent& event) override {
+    drop_index_ = IndexAt(event.location());
+    for (size_t i = 0; i < buttons_.size(); ++i) {
+      buttons_[i]->SetDropTarget(i == drop_index_);
+    }
+    return ui::DragDropTypes::DRAG_MOVE;
+  }
+  void OnDragExited() override {
+    for (auto& button : buttons_) {
+      button->SetDropTarget(false);
+    }
+  }
+  DropCallback GetDropCallback(const ui::DropTargetEvent& event) override {
+    std::string id = ReadDrag(event.data());
+    const size_t index = IndexAt(event.location());
+    OnDragExited();
+    return base::BindOnce(
+        [](base::WeakPtr<FavoritesView> view, std::string id, size_t index,
+           const ui::DropTargetEvent&, ui::mojom::DragOperation& operation,
+           std::unique_ptr<ui::LayerTreeOwner>) {
+          if (view && view->controller_.Move(id, index)) {
+            operation = ui::mojom::DragOperation::kMove;
+          }
+        },
+        weak_factory_.GetWeakPtr(), id, index);
+  }
+  void WriteDragDataForView(views::View* sender,
+                            const gfx::Point& press_point,
+                            ui::OSExchangeData* data) override {
+    base::Pickle pickle;
+    pickle.WriteString(IdFor(sender));
+    data->SetPickledData(FavoriteFormat(), pickle);
+    // Cocoa requires a non-empty image to start a native dragging session.
+    auto* button = views::AsViewClass<FavoriteButton>(sender);
+    data->provider().SetDragImage(button->GetImage(views::Button::STATE_NORMAL),
+                                  press_point.OffsetFromOrigin());
+  }
+  int GetDragOperationsForView(views::View*, const gfx::Point&) override {
+    return ui::DragDropTypes::DRAG_MOVE;
+  }
+  bool CanStartDragForView(views::View*,
+                           const gfx::Point& press,
+                           const gfx::Point& current) override {
+    return ExceededDragThreshold(current - press);
+  }
+  void ExecuteCommand(int command, int) override {
+    const auto id = menu_id_;
+    if (command == 1) {
+      controller_.Open(id, true);
+    }
+    if (command == 2) {
+      controller_.Remove(id);
+    }
+    auto saved = controller_.entries();
+    auto it = std::ranges::find(saved, id, &Favorite::id);
+    if (it == saved.end()) {
+      return;
+    }
+    const size_t index = it - saved.begin();
+    if (command == 3 && index > 0) {
+      controller_.Move(id, index - 1);
+    }
+    if (command == 4 && index + 1 < saved.size()) {
+      controller_.Move(id, index + 1);
+    }
+  }
+  bool IsCommandIdEnabled(int command) const override {
+    auto saved = controller_.entries();
+    auto it = std::ranges::find(saved, menu_id_, &Favorite::id);
+    if (it == saved.end()) {
+      return false;
+    }
+    return (command != 3 || it != saved.begin()) &&
+           (command != 4 || it + 1 != saved.end());
+  }
+
+ private:
+  static int Columns(int width) { return std::clamp((width - 16) / 54, 1, 4); }
+  static int HeaderHeight(int width) { return width >= 100 ? 30 : 0; }
+  void Layout(PassKey) override {
+    const int header = HeaderHeight(width());
+    label_->SetVisible(header != 0);
+    add_->SetVisible(header != 0);
+    label_->SetBounds(12, 0, std::max(0, width() - 48), header);
+    add_->SetBounds(std::max(0, width() - 36), 0, 28, header);
+    scroll_->SetBounds(6, header, std::max(0, width() - 12),
+                       std::max(0, height() - header - 8));
+    const int cols = Columns(width());
+    const int tile_width = std::max(24, (width() - 12 - (cols - 1) * 6) / cols);
+    const int rows = (buttons_.size() + cols - 1) / cols;
+    grid_->SetPreferredSize(gfx::Size(std::max(0, width() - 12), rows * 54));
+    grid_->SetSize(gfx::Size(std::max(0, width() - 12), rows * 54));
+    for (size_t i = 0; i < buttons_.size(); ++i) {
+      buttons_[i]->SetBounds((i % cols) * (tile_width + 6), (i / cols) * 54,
+                             tile_width, 48);
+    }
+  }
+  void Refresh() {
+    auto saved = controller_.entries();
+    std::vector<std::string> ids;
+    for (const auto& entry : saved) {
+      ids.push_back(entry.id);
+    }
+    if (ids != ids_) {
+      buttons_.clear();
+      grid_->RemoveAllChildViews();
+      ids_ = ids;
+      for (const auto& entry : saved) {
+        auto* button = grid_->AddChildView(
+            std::make_unique<FavoriteButton>(base::BindRepeating(
+                [](FavoritesController* c, std::string id) { c->Open(id); },
+                base::Unretained(&controller_), entry.id)));
+        button->set_context_menu_controller(this);
+        button->set_drag_controller(this);
+        buttons_.push_back(button);
+      }
+    }
+    for (size_t i = 0; i < saved.size(); ++i) {
+      const auto& entry = saved[i];
+      auto* tab = controller_.FindTab(entry.id);
+      auto* contents = tab ? tab->GetContents() : nullptr;
+      const auto title = entry.title.empty()
+                             ? base::UTF8ToUTF16(entry.url.host())
+                             : entry.title;
+      auto* button = buttons_[i].get();
+      button->SetAccessibleName(u"Favorite: " + title);
+      button->SetTooltipText(title + u"\n" +
+                             base::UTF8ToUTF16(entry.url.host()));
+      ui::ImageModel icon = ui::ImageModel::FromVectorIcon(
+          vector_icons::kGlobeIcon, ui::kColorPrimaryForeground, 20);
+      if (auto* driver =
+              contents
+                  ? favicon::ContentFaviconDriver::FromWebContents(contents)
+                  : nullptr;
+          driver && !driver->GetFavicon().IsEmpty()) {
+        icon =
+            ui::ImageModel::FromImageSkia(driver->GetFavicon().AsImageSkia());
+        icons_[entry.id] = icon;
+      } else if (icons_.contains(entry.id)) {
+        icon = icons_[entry.id];
+      }
+      if (!icons_.contains(entry.id) && !requested_icons_.contains(entry.id) &&
+          browser_) {
+        requested_icons_.insert(entry.id);
+        if (auto* service = FaviconServiceFactory::GetForProfile(
+                browser_->GetProfile(), ServiceAccessType::IMPLICIT_ACCESS)) {
+          service->GetFaviconImageForPageURL(
+              entry.url,
+              base::BindOnce(
+                  [](base::WeakPtr<FavoritesView> view, std::string id,
+                     const favicon_base::FaviconImageResult& result) {
+                    if (!view || result.image.IsEmpty() ||
+                        std::ranges::find(view->ids_, id) == view->ids_.end()) {
+                      return;
+                    }
+                    view->icons_[id] = ui::ImageModel::FromImageSkia(
+                        result.image.AsImageSkia());
+                    view->Refresh();
+                  },
+                  weak_factory_.GetWeakPtr(), entry.id),
+              &icon_tasks_);
+        }
+      }
+      button->SetImageModel(views::Button::STATE_NORMAL, icon);
+      button->SetActive(browser_ && tab &&
+                        browser_->GetTabStripModel()->GetActiveTab() == tab);
+    }
+    std::erase_if(icons_, [&](const auto& pair) {
+      return std::ranges::find(ids_, pair.first) == ids_.end();
+    });
+    add_->SetEnabled(controller_.CanAddActive());
+    PreferredSizeChanged();
+    InvalidateLayout();
+    if (changed_) {
+      changed_.Run();
+    }
+  }
+  std::string IdFor(views::View* source) const {
+    for (size_t i = 0; i < buttons_.size(); ++i) {
+      if (buttons_[i] == source) {
+        return ids_[i];
+      }
+    }
+    return {};
+  }
+  std::string ReadDrag(const ui::OSExchangeData& data) const {
+    if (data.IsRendererTainted()) {
+      return {};
+    }
+    auto pickle = data.GetPickledData(FavoriteFormat());
+    if (!pickle) {
+      return {};
+    }
+    std::string id;
+    if (!base::PickleIterator(*pickle).ReadString(&id) ||
+        std::ranges::find(ids_, id) == ids_.end()) {
+      return {};
+    }
+    return id;
+  }
+  size_t IndexAt(gfx::Point point) const {
+    views::View::ConvertPointToTarget(this, grid_, &point);
+    const int cols = Columns(width());
+    const int tile_width = std::max(24, (width() - 12 - (cols - 1) * 6) / cols);
+    return std::clamp(std::max(0, point.y()) / 54 * cols +
+                          std::clamp(point.x() / (tile_width + 6), 0, cols - 1),
+                      0, std::max(0, static_cast<int>(ids_.size()) - 1));
+  }
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    menu_id_ = IdFor(source);
+    menu_runner_.reset();
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    menu_model_->AddItem(1, u"Reset to saved URL");
+    menu_model_->AddItem(2, u"Move to pinned tabs");
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItem(3, u"Move earlier");
+    menu_model_->AddItem(4, u"Move later");
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+    menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                            views::MenuAnchorPosition::kTopLeft, source_type);
+  }
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  base::RepeatingClosure changed_;
+  FavoritesController controller_;
+  raw_ptr<views::Label> label_ = nullptr;
+  raw_ptr<views::LabelButton> add_ = nullptr;
+  raw_ptr<views::ScrollView> scroll_ = nullptr;
+  raw_ptr<views::View> grid_ = nullptr;
+  std::vector<raw_ptr<FavoriteButton>> buttons_;
+  std::vector<std::string> ids_;
+  std::map<std::string, ui::ImageModel> icons_;
+  std::set<std::string> requested_icons_;
+  base::CancelableTaskTracker icon_tasks_;
+  size_t drop_index_ = 0;
+  std::string menu_id_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  base::WeakPtrFactory<FavoritesView> weak_factory_{this};
+};
