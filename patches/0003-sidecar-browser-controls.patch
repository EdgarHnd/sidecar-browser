+TEST_F(SidecarPinnedTabTest, SavedFavoritesOpenByReusingRegularTabs) {
+  AddTab(browser(), GURL("https://example.test/home"));
+  sidecar::FavoritesController favorites(browser(), base::RepeatingClosure());
+  ASSERT_TRUE(favorites.AddActive());
+  const auto id = favorites.entries()[0].id;
+  auto* model = browser()->GetTabStripModel();
+  model->SetTabPinned(0, false);
+  EXPECT_EQ(nullptr, favorites.FindTab(id));
