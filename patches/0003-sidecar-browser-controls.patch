+// Copyright 2026 The Sidecar Authors. MPL-2.0.
+#include "brave/browser/ui/sidecar_favorites.h"
+
+#include <algorithm>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/uuid.h"
+#include "brave/browser/ui/tabs/brave_tab_prefs.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+
+namespace sidecar {
+namespace {
+using Controllers = std::vector<FavoritesController*>;
+Controllers& AllControllers() {
+  static base::NoDestructor<Controllers> controllers;
+  return *controllers;
+}
+bool ValidURL(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+}  // namespace
+FavoritesController::FavoritesController(BrowserWindowInterface* browser,
+                                         base::RepeatingClosure changed)
+    : browser_(browser->GetWeakPtr()), changed_(std::move(changed)) {
+  AllControllers().push_back(this);
+  browser->GetTabStripModel()->AddObserver(this);
+  prefs_observer_.Init(browser->GetProfile()->GetPrefs());
+  prefs_observer_.Add(brave_tabs::kSidecarFavorites,
+                      base::BindRepeating(&FavoritesController::ScheduleRefresh,
+                                          base::Unretained(this)));
+  ScheduleRefresh();
+}
+FavoritesController::~FavoritesController() {
+  std::erase(AllControllers(), this);
+}
+FavoritesController* FavoritesController::ForBrowser(
+    BrowserWindowInterface* browser) {
+  for (auto* controller : AllControllers()) {
+    if (controller->browser_.get() == browser) {
+      return controller;
+    }
+  }
+  return nullptr;
+}
+std::vector<Favorite> FavoritesController::entries() const {
+  std::vector<Favorite> result;
+  if (!browser_) {
+    return result;
+  }
+  for (const auto& value : browser_->GetProfile()->GetPrefs()->GetList(
+           brave_tabs::kSidecarFavorites)) {
+    const auto* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const auto* id = dict->FindString("id");
+    const auto* url = dict->FindString("url");
+    const auto* title = dict->FindString("title");
+    if (!id || !url || !ValidURL(GURL(*url)) ||
+        !base::Uuid::ParseLowercase(*id).is_valid()) {
+      continue;
+    }
+    if (std::ranges::any_of(result,
+                            [&](const Favorite& f) { return f.id == *id; })) {
+      continue;
+    }
+    const auto* last_url = dict->FindString("last_url");
+    result.push_back({*id, GURL(*url), last_url ? GURL(*last_url) : GURL(*url),
+                      base::UTF8ToUTF16(title ? *title : GURL(*url).host())});
+    if (result.size() == kMaxFavorites) {
+      break;
+    }
+  }
+  return result;
+}
+bool FavoritesController::CanAddActive() const {
+  if (!browser_) {
+    return false;
+  }
+  auto* active = browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!active || !ValidURL(active->GetVisibleURL())) {
+    return false;
+  }
+  auto saved = entries();
+  return saved.size() < kMaxFavorites &&
+         !Contains(browser_->GetTabStripModel()->GetActiveTab()) &&
+         std::ranges::none_of(
+             saved,
+             [&](const Favorite& f) {
+               return f.url == active->GetVisibleURL();
+             });
+}
+bool FavoritesController::AddActive() {
+  if (!CanAddActive()) {
+    return false;
+  }
+  auto* model = browser_->GetTabStripModel();
+  auto* tab = model->GetActiveTab();
+  auto* contents = tab->GetContents();
+  std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::DictValue entry;
+  entry.Set("id", id);
+  entry.Set("url", contents->GetVisibleURL().spec());
+  entry.Set("last_url", contents->GetVisibleURL().spec());
+  entry.Set("title", base::UTF16ToUTF8(contents->GetTitle().substr(0, 512)));
+  tabs_[id] = tab->GetHandle();
+  model->SetTabPinned(model->active_index(), true);
+  ScopedListPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              brave_tabs::kSidecarFavorites);
+  update->Append(std::move(entry));
+  ScheduleRefresh();
+  return true;
+}
+bool FavoritesController::Remove(const std::string& id) {
+  if (!browser_) {
+    return false;
+  }
+  ScopedListPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              brave_tabs::kSidecarFavorites);
+  const size_t removed = update->EraseIf([&](const base::Value& value) {
+    const auto* dict = value.GetIfDict();
+    const auto* entry_id = dict ? dict->FindString("id") : nullptr;
+    return entry_id && *entry_id == id;
+  });
+  tabs_.erase(id);
+  last_seen_.erase(id);
+  return removed != 0;
+}
+bool FavoritesController::Move(const std::string& id, size_t index) {
+  if (!browser_) {
+    return false;
+  }
+  ScopedListPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              brave_tabs::kSidecarFavorites);
+  auto saved = entries();
+  if (index >= saved.size()) {
+    return false;
+  }
+  const auto target_id = saved[index].id;
+  size_t target_index = 0;
+  for (size_t i = 0; i < update->size(); ++i) {
+    const auto* dict = (*update)[i].GetIfDict();
+    if (dict && dict->FindString("id") &&
+        *dict->FindString("id") == target_id) {
+      target_index = i;
+    }
+  }
+  for (size_t i = 0; i < update->size(); ++i) {
+    auto* dict = (*update)[i].GetIfDict();
+    if (dict && dict->FindString("id") && *dict->FindString("id") == id) {
+      auto value = (*update)[i].Clone();
+      update->erase(update->begin() + i);
+      update->Insert(update->begin() + target_index, std::move(value));
+      return true;
+    }
+  }
+  return false;
+}
+tabs::TabInterface* FavoritesController::FindTab(const std::string& id) const {
+  if (!browser_) {
+    return nullptr;
+  }
+  auto it = tabs_.find(id);
+  if (it == tabs_.end()) {
+    return nullptr;
+  }
+  auto* tab = it->second.Get();
+  const auto* model = browser_->GetTabStripModel();
+  const int index = tab ? model->GetIndexOfTab(tab) : -1;
+  return index >= 0 && model->IsTabPinned(index) ? tab : nullptr;
+}
+bool FavoritesController::Contains(const tabs::TabInterface* tab) const {
+  if (!tab) {
+    return false;
+  }
+  for (const auto& [id, handle] : tabs_) {
+    if (handle.Get() == tab && FindTab(id)) {
+      return true;
+    }
+  }
+  return false;
+}
+void FavoritesController::Open(const std::string& id, bool reset) {
+  if (!browser_) {
+    return;
+  }
+  auto saved = entries();
+  auto it = std::ranges::find(saved, id, &Favorite::id);
+  if (it == saved.end()) {
+    return;
+  }
+  auto* model = browser_->GetTabStripModel();
+  if (auto* tab = FindTab(id)) {
+    model->ActivateTabAt(model->GetIndexOfTab(tab));
+    if (reset) {
+      content::NavigationController::LoadURLParams params(it->url);
+      params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+      tab->GetContents()->GetController().LoadURLWithParams(params);
+    }
+    tab->GetContents()->Focus();
+    return;
+  }
+  // Reuse a matching page in this window before opening another copy.
+  for (int i = 0; i < model->count(); ++i) {
+    if (model->GetWebContentsAt(i)->GetVisibleURL() == it->url &&
+        !Contains(model->GetTabAtIndex(i))) {
+      tabs_[id] = model->GetTabAtIndex(i)->GetHandle();
+      model->SetTabPinned(i, true);
+      model->ActivateTabAt(model->GetIndexOfTab(tabs_[id].Get()));
+      ScheduleRefresh();
+      return;
+    }
+  }
+  NavigateParams params(browser_.get(), it->url,
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  if (params.navigated_or_inserted_contents) {
+    const int index =
+        model->GetIndexOfWebContents(params.navigated_or_inserted_contents);
+    if (index >= 0) {
+      tabs_[id] = model->GetTabAtIndex(index)->GetHandle();
+      model->SetTabPinned(index, true);
+    }
+  }
+  ScheduleRefresh();
+}
+void FavoritesController::OnTabStripModelChanged(
+    TabStripModel*,
+    const TabStripModelChange&,
+    const TabStripSelectionChange&) {
+  ScheduleRefresh();
+}
+void FavoritesController::OnTabChangedAt(tabs::TabInterface*, TabChangeType) {
+  ScheduleRefresh();
+}
+void FavoritesController::ScheduleRefresh() {
+  if (refresh_pending_) {
+    return;
+  }
+  refresh_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&FavoritesController::Refresh,
+                                weak_factory_.GetWeakPtr()));
+}
+void FavoritesController::Refresh() {
+  refresh_pending_ = false;
+  if (!browser_ || browser_->GetTabStripModel()->closing_all()) {
+    return;
+  }
+  auto saved = entries();
+  std::erase_if(tabs_, [&](const auto& pair) {
+    return !FindTab(pair.first) ||
+           std::ranges::none_of(
+               saved, [&](const Favorite& f) { return f.id == pair.first; });
+  });
+  std::erase_if(last_seen_,
+                [&](const auto& pair) { return !tabs_.contains(pair.first); });
+  auto* model = browser_->GetTabStripModel();
+  // Session restore recreates tab handles. Reassociate only pinned tabs with
+  // the saved home or last visited URL; never convert unrelated regular tabs.
+  for (const auto& entry : saved) {
+    if (FindTab(entry.id)) {
+      continue;
+    }
+    for (int i = 0; i < model->IndexOfFirstNonPinnedTab(); ++i) {
+      auto* tab = model->GetTabAtIndex(i);
+      const auto& url = tab->GetContents()->GetVisibleURL();
+      if (!Contains(tab) && (url == entry.url || url == entry.last_url)) {
+        tabs_[entry.id] = tab->GetHandle();
+        break;
+      }
+    }
+  }
+  {
+    auto* prefs = browser_->GetProfile()->GetPrefs();
+    auto updated = prefs->GetList(brave_tabs::kSidecarFavorites).Clone();
+    for (auto& value : updated) {
+      auto* dict = value.GetIfDict();
+      const auto* id = dict ? dict->FindString("id") : nullptr;
+      auto* tab = id ? FindTab(*id) : nullptr;
+      if (!tab) {
+        continue;
+      }
+      const auto& url = tab->GetContents()->GetLastCommittedURL();
+      if (ValidURL(url) && last_seen_[*id] != url) {
+        last_seen_[*id] = url;
+        dict->Set("last_url", url.spec());
+      }
+    }
+    if (updated != prefs->GetList(brave_tabs::kSidecarFavorites)) {
+      prefs->SetList(brave_tabs::kSidecarFavorites, std::move(updated));
+    }
+  }
+  if (changed_) {
+    changed_.Run();
+  }
+}
+bool IsFavoriteTab(const tabs::TabInterface* tab) {
+  return std::ranges::any_of(AllControllers(),
+                             [&](const auto* c) { return c->Contains(tab); });
+}
+}  // namespace sidecar
