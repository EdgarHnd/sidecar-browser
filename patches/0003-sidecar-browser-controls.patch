+#include "components/prefs/pref_service.h"
+#include "content/public/browser/content_browser_client.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/content_client.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+class SidecarPinnedTabTest : public BrowserWithTestWindowTest {
+ public:
+  void SetUp() override {
+    previous_client_ = content::SetBrowserClientForTesting(&browser_client_);
+    BrowserWithTestWindowTest::SetUp();
+  }
+  void TearDown() override {
+    BrowserWithTestWindowTest::TearDown();
+    content::SetBrowserClientForTesting(previous_client_);
+  }
+
+ private:
+  ChromeContentBrowserClient browser_client_;
+  raw_ptr<content::ContentBrowserClient> previous_client_ = nullptr;
+};
+
+TEST_F(SidecarPinnedTabTest, EmptyWindowFallsThrough) {
+  EXPECT_FALSE(sidecar::ClosePinnedTab(browser()));
+}
+
+TEST_F(SidecarPinnedTabTest, RegularTabUsesNormalClose) {
+  AddTab(browser(), GURL("https://example.test/regular"));
+  EXPECT_FALSE(sidecar::ClosePinnedTab(browser()));
+  EXPECT_EQ(1, browser()->GetTabStripModel()->count());
+}
+
+TEST_F(SidecarPinnedTabTest, CloseKeepsPinAndSelectsAnotherTab) {
+  AddTab(browser(), GURL("https://example.test/pin"));
+  auto* model = browser()->GetTabStripModel();
+  model->SetTabPinned(0, true);
+  AddTab(browser(), GURL("https://example.test/regular"));
+  model->ActivateTabAt(0);
+  EXPECT_TRUE(sidecar::ClosePinnedTab(browser()));
+  EXPECT_EQ(2, model->count());
+  EXPECT_TRUE(model->IsTabPinned(0));
+  EXPECT_EQ(1, model->active_index());
+  EXPECT_EQ(GURL("https://example.test/pin"),
+            model->GetWebContentsAt(0)->GetVisibleURL());
+}
+
+TEST_F(SidecarPinnedTabTest, LastPinKeepsWindowAndCreatesLandingTab) {
+  AddTab(browser(), GURL("https://example.test/pin"));
+  auto* model = browser()->GetTabStripModel();
+  model->SetTabPinned(0, true);
+  EXPECT_TRUE(sidecar::ClosePinnedTab(browser()));
+  EXPECT_EQ(2, model->count());
+  EXPECT_TRUE(model->IsTabPinned(0));
+  EXPECT_FALSE(model->IsTabPinned(model->active_index()));
+}
+
+TEST_F(SidecarPinnedTabTest, RepeatedCloseNeverRemovesPin) {
+  AddTab(browser(), GURL("https://example.test/pin"));
+  auto* model = browser()->GetTabStripModel();
+  model->SetTabPinned(0, true);
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    model->ActivateTabAt(0);
+    EXPECT_TRUE(sidecar::ClosePinnedTab(browser()));
+    EXPECT_EQ(2, model->count());
+    EXPECT_TRUE(model->IsTabPinned(0));
+  }
+}
+
+TEST_F(SidecarPinnedTabTest, QuietShellDoesNotOverrideLaterCustomization) {
+  auto* prefs = profile()->GetPrefs();
+  sidecar::InitializeProfileUI(prefs);
+  EXPECT_EQ(static_cast<int>(brave::NewTabPageShowsOptions::kBlankpage),
+            prefs->GetInteger(kNewTabPageShowsOptions));
+  EXPECT_FALSE(prefs->GetBoolean(bookmarks::prefs::kShowBookmarkBar));
+  prefs->SetInteger(
+      kNewTabPageShowsOptions,
+      static_cast<int>(brave::NewTabPageShowsOptions::kDashboard));
+  prefs->SetBoolean(bookmarks::prefs::kShowBookmarkBar, true);
+  sidecar::InitializeProfileUI(prefs);
+  EXPECT_EQ(static_cast<int>(brave::NewTabPageShowsOptions::kDashboard),
+            prefs->GetInteger(kNewTabPageShowsOptions));
+  EXPECT_TRUE(prefs->GetBoolean(bookmarks::prefs::kShowBookmarkBar));
+}
