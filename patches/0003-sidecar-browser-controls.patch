+}
+
+class CommandResult : public views::Button {
+  METADATA_HEADER(CommandResult, views::Button)
+ public:
+  CommandResult(PressedCallback callback,
+                const std::u16string& title,
+                const std::u16string& detail,
+                const std::u16string& action,
+                const ui::ImageModel& image)
+      : views::Button(std::move(callback)) {
+    SetAccessibleName(title + u", " + detail + u", " + action);
+    SetTooltipText(title + u"\n" + detail);
+    SetPreferredSize(gfx::Size(0, 52));
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(8, 12),
+        12));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* icon = AddChildView(std::make_unique<views::ImageView>());
+    icon->SetImage(image);
+    icon->SetImageSize(gfx::Size(20, 20));
+    icon->SetPreferredSize(gfx::Size(24, 24));
+    auto* copy = AddChildView(std::make_unique<views::View>());
+    copy->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 2));
+    layout->SetFlexForView(copy, 1);
+    title_ = copy->AddChildView(std::make_unique<views::Label>(title));
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetFontList(title_->font_list().DeriveWithSizeDelta(1));
+    title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    detail_ = copy->AddChildView(std::make_unique<views::Label>(detail));
+    detail_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    detail_->SetFontList(detail_->font_list().DeriveWithSizeDelta(-1));
+    detail_->SetElideBehavior(gfx::ELIDE_MIDDLE);
+    action_ = AddChildView(std::make_unique<views::Label>(action));
+    action_->SetFontList(action_->font_list().DeriveWithSizeDelta(-1));
+    UpdateColors();
+  }
+  void SetSelected(bool selected) {
+    selected_ = selected;
+    UpdateColors();
+  }
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    UpdateColors();
+  }
+
+ private:
+  void UpdateColors() {
+    if (!title_) {
+      return;
+    }
+    const bool highlighted = selected_ || GetState() == STATE_HOVERED;
+    SetBackground(views::CreateRoundedRectBackground(
+        highlighted ? ui::kColorSysPrimaryContainer
+                    : ui::kColorPrimaryBackground,
+        10));
+    title_->SetEnabledColor(highlighted ? ui::kColorSysOnPrimaryContainer
+                                        : ui::kColorPrimaryForeground);
+    detail_->SetEnabledColor(highlighted ? ui::kColorSysOnPrimaryContainer
+                                         : ui::kColorSecondaryForeground);
+    action_->SetEnabledColor(highlighted ? ui::kColorSysOnPrimaryContainer
+                                         : ui::kColorSecondaryForeground);
+  }
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> detail_ = nullptr;
+  raw_ptr<views::Label> action_ = nullptr;
+  bool selected_ = false;
+};
+BEGIN_METADATA(CommandResult)
+END_METADATA
